#!/bin/sh
# udhcpc event script for the network installer (busybox udhcpc).
case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface" 2>/dev/null
        ip link set "$interface" up ;;
    bound|renew)
        ip -4 addr flush dev "$interface" 2>/dev/null
        ip -4 addr add "$ip/${mask:-24}" dev "$interface"
        if [ -n "$router" ]; then
            ip -4 route del default dev "$interface" 2>/dev/null
            for r in $router; do ip -4 route add default via "$r" dev "$interface" && break; done
        fi
        : > /etc/resolv.conf
        for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done ;;
esac
exit 0
